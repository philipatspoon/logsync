#!/bin/bash
# Startfil för Logsync. Startar menyradsappen i bakgrunden och avslutar direkt.
# macOS väntar annars på att appen ska anmäla sig, och eftersom Python tar flera
# sekunder (första gången minuter) att starta ger macOS upp med "appen svarar inte".
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
LOG="$HOME/Library/Logs/Logsync.log"
mkdir -p "$HOME/Library/Logs"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
# Redan igång, eller på väg att starta? Då gör vi inget.
if curl -s -m 1 -H 'X-Logsync: 1' http://127.0.0.1:47811/status | grep -q '"ok"'; then exit 0; fi
if pgrep -f "$RES/run.sh" >/dev/null || pgrep -f "$RES/menubar.py" >/dev/null; then exit 0; fi
nohup /bin/bash "$RES/run.sh" >>"$LOG" 2>&1 </dev/null &
disown
exit 0
